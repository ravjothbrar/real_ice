{
  "name": "survival-gap-atlas-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fixture": "node dev/make-fixture.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single && node scripts/inline-single.mjs",
    "preview": "vite preview",
    "shots": "node dev/screenshots.cjs"
  },
  "dependencies": {
    "d3-geo": "3.1.2",
    "d3-selection": "3.0.1",
    "d3-transition": "3.0.1",
    "d3-zoom": "3.0.1"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.1",
    "@types/d3-selection": "3.0.13",
    "@types/d3-zoom": "3.0.9",
    "@types/geojson": "7946.0.16",
    "@types/topojson-client": "3.1.5",
    "topojson-client": "3.1.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "world-atlas": "2.0.2",
    "@types/d3-transition": "3.0.9"
  }
}
